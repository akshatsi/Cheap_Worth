# Copy this file to .env and fill in real values. Never commit .env itself.

GROQ_API_KEY=

# Optional — defaults to llama-3.1-8b-instant if unset.
GROQ_CLASSIFIER_MODEL=

# The routed tiers (Haiku/Sonnet/Opus equivalents) run on a local Ollama
# server. No key needed — just `ollama serve` running and these models
# pulled (`ollama pull <model>`). Defaults below match what's already
# pulled locally except the Opus tier, which needs its own pull.
OLLAMA_HOST=
OLLAMA_HAIKU_MODEL=
OLLAMA_SONNET_MODEL=
OLLAMA_OPUS_MODEL=
